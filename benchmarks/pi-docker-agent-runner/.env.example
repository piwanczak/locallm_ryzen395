# Copy to .env only if you want compose defaults outside the wrapper scripts.
OPENAI_API_BASE=http://host.docker.internal:1234/v1
OPENAI_API_KEY=not-needed

# Optional provider keys, only if you deliberately test cloud fallback routes.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
