{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio timing proxy",
      "options": {
        "baseURL": "http://127.0.0.1:5678/v1",
        "apiKey": "lmstudio"
      },
      "models": {
        "qwen/qwen3-coder-30b": {
          "name": "Qwen3 Coder 30B local",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "google/gemma-4-e4b": {
          "name": "Gemma 4 E4B local",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        }
      }
    }
  },
  "model": "lmstudio/qwen/qwen3-coder-30b",
  "small_model": "lmstudio/qwen/qwen3-coder-30b",
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "websearch": "deny",
    "question": "deny",
    "bash": {
      "*&&*": "deny",
      "*": "allow",
      "rm *": "deny",
      "rm -rf *": "deny",
      "del *": "deny",
      "erase *": "deny",
      "Remove-Item *": "deny",
      "git commit *": "deny",
      "git push *": "deny",
      "npm install *": "deny",
      "pnpm install *": "deny",
      "yarn add *": "deny"
    }
  },
  "share": "disabled",
  "autoupdate": false
}
